{
  "name": "@noor.ahamed/kill-port",
  "version": "1.0.3",
  "description": "Cross-platform CLI to kill process(es) listening on a TCP port",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kill-port": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/patch-execa-loader.js",
    "test": "vitest run",
    "lint": "eslint src tests --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "port",
    "kill",
    "tcp",
    "cross-platform"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NooryA/kill-port"
  },
  "bugs": {
    "url": "https://github.com/NooryA/kill-port/issues"
  },
  "homepage": "https://github.com/NooryA/kill-port#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "execa": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
